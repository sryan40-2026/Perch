---
// Live Buttondown signup form.
//
// The `action` URL and the `name="email"` field below come from Sean's
// Buttondown account (buttondown.com → Settings → Embedding). Don't hand-edit
// them — if the form ever stops working, re-copy the snippet from that page.
//
// The form works with no JavaScript at all: it posts straight to Buttondown and
// opens their confirmation page in a new tab. The script below progressively
// enhances that — same endpoint, same field, same POST — but keeps the reader
// on this page and prints the confirmation here instead.
---

<section class="subscribe" id="subscribe">
  <p class="subscribe__label">Subscribe</p>
  <p class="subscribe__note">
    One photo a week, with a short story underneath. Nothing else.
  </p>

  <form
    action="https://buttondown.com/api/emails/embed-subscribe/sryan40"
    method="post"
    target="_blank"
    class="subscribe__form embeddable-buttondown-form"
    data-subscribe-form
  >
    <label class="visually-hidden" for="bd-email">Enter your email</label>
    <input
      class="subscribe__input"
      type="email"
      name="email"
      id="bd-email"
      placeholder="you@example.com"
      autocomplete="email"
      required
    />
    <input class="subscribe__button" type="submit" value="Subscribe" />
  </form>

  <p class="subscribe__status" data-subscribe-status role="status" aria-live="polite"></p>

  <p class="subscribe__credit">
    <a
      href="https://buttondown.com/refer/sryan40"
      target="_blank"
      rel="noopener">Powered by Buttondown.</a
    >
  </p>
</section>

<script>
  const form = document.querySelector('[data-subscribe-form]');
  const status = document.querySelector('[data-subscribe-status]');

  if (form instanceof HTMLFormElement && status) {
    const button = form.querySelector('input[type="submit"]');
    const input = form.querySelector('input[type="email"]');

    form.addEventListener('submit', async (event) => {
      if (!(input instanceof HTMLInputElement) || !input.checkValidity()) return;

      // Only take over once we're sure we can: past this point the reader
      // stays on the page, so any failure has to be reported here too.
      event.preventDefault();

      const original =
        button instanceof HTMLInputElement ? button.value : 'Subscribe';
      if (button instanceof HTMLInputElement) {
        button.disabled = true;
        button.value = 'Subscribing…';
      }
      status.textContent = '';
      status.classList.remove('is-error');

      try {
        // `no-cors` means the response is opaque — Buttondown receives and
        // processes the POST, but we can't read the result. Anything the
        // reader needs to know has to come from their inbox, so the message
        // below points there rather than claiming more than we know.
        await fetch(form.action, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({ email: input.value }),
        });

        form.hidden = true;
        status.textContent =
          'Thanks — check your inbox to confirm, and the next photo will find you there.';
      } catch {
        // Network failure. Re-enable and hand them the working fallback
        // rather than leaving them stuck.
        if (button instanceof HTMLInputElement) {
          button.disabled = false;
          button.value = original;
        }
        status.classList.add('is-error');
        status.textContent =
          'That didn’t go through — check your connection, or subscribe at buttondown.com/sryan40.';
      }
    });
  }
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .subscribe__status:empty {
    display: none;
  }

  .subscribe__status {
    margin: 1.25rem 0 0;
    max-width: var(--measure);
  }

  .subscribe__status.is-error {
    color: var(--ink-soft);
  }

  .subscribe__credit {
    margin: 1rem 0 0;
    font-size: 0.75rem;
    color: var(--ink-soft);
  }

  .subscribe__credit a {
    color: inherit;
  }
</style>
