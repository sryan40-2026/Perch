---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import Subscribe from '../components/Subscribe.astro';
import { SITE } from '../consts';

// getCollection's order is not guaranteed — always sort explicitly.
// Newest first: the journal reads top-down through the history.
const entries = (await getCollection('entries')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base>
  <p class="tagline">{SITE.description}</p>

  <div class="stream">
    {entries.map((entry, i) => <Entry entry={entry} linked priority={i === 0} />)}
  </div>

  <Subscribe />
</Base>
