# Perch likes — Supabase connection.
# These are PUBLIC values (safe to expose in the browser); the database is
# protected by row-level security, not by hiding these.
#
# Copy this file to `.env` for local dev, and add the same two variables in
# Vercel → Project → Settings → Environment Variables for the live site.
#
# Find both values in Supabase → Project Settings → API.

PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
